# ElevenLabs API Settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: comma-separated list of keys for automatic fallback when one runs
# out of quota (e.g. multiple free accounts). Overrides ELEVENLABS_API_KEY if set.
# ELEVENLABS_API_KEYS=key_one,key_two,key_three
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # Recommended: George

# Free fallback (auto-used when ElevenLabs has no key, not enough quota left
# for the whole video, OR the script is auto-detected as Vietnamese — ElevenLabs
# has no native Vietnamese voice, so edge-tts's dedicated Vietnamese voice is
# used instead regardless of quota). Requires: pip install edge-tts
# EDGE_TTS_VOICE_EN=en-US-AndrewNeural   # Warm, Confident storyteller — closest free match to "George"
# EDGE_TTS_VOICE_VI=vi-VN-NamMinhNeural  # Native Vietnamese male voice (or vi-VN-HoaiMyNeural for female)
# EDGE_TTS_VOICE=en-US-AndrewNeural  # Legacy: pins ONE voice for every run, disabling language auto-detection

# Gemini API Settings (Phase 3 Auto Prompt Generator)
GEMINI_API_KEY=your_gemini_api_key_here

# Stock B-roll footage sources (Phase 2c). Both are free, key-based, no cost.
# Pixabay is queried alongside Pexels to widen the pool of candidate clips per
# section (different library than Pexels, so it fills gaps Pexels misses) —
# sign up free at https://pixabay.com/api/docs/ to get a key.
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

