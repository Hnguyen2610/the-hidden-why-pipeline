# ElevenLabs API Settings
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: comma-separated list of keys for automatic fallback when one runs
# out of quota (e.g. multiple free accounts). Overrides ELEVENLABS_API_KEY if set.
# ELEVENLABS_API_KEYS=key_one,key_two,key_three
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # Recommended: George

# Free fallback (auto-used when ElevenLabs has no key or not enough quota
# left for the whole video, so a video never mixes ElevenLabs + edge-tts voices)
# Requires: pip install edge-tts
# EDGE_TTS_VOICE=en-US-AndrewNeural  # Warm, Confident storyteller — closest free match to "George"

# Gemini API Settings (Phase 3 Auto Prompt Generator)
GEMINI_API_KEY=your_gemini_api_key_here

